#!/bin/sh
# After removal. "remove" keeps the till's data (sales not yet synced, its
# key and enrollment); only "purge" erases it.
set -e
case "$1" in
  purge)
    rm -rf /var/lib/nguon-edge /etc/systemd/system/nguon-edge.service.d
    if id nguon-edge >/dev/null 2>&1; then deluser --system nguon-edge >/dev/null 2>&1 || true; fi
    systemctl daemon-reload || true
    ;;
  remove)
    systemctl daemon-reload || true
    ;;
esac
exit 0
