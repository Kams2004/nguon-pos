#!/bin/sh
# Before removing or upgrading: stop the local server (data stays).
set -e
case "$1" in
  remove|deconfigure)
    systemctl stop nguon-edge.service nguon-updater.path || true
    systemctl disable nguon-edge.service nguon-updater.path >/dev/null 2>&1 || true
    ;;
  upgrade)
    # The watcher stays: an automatic update runs inside nguon-updater.service.
    systemctl stop nguon-edge.service || true
    ;;
esac
exit 0
