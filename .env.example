# Copy to .env and fill in real values before `docker-compose up`.
# Never commit the real .env file — see .gitignore.

POSTGRES_USER=nguonpos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nguonpos

DB_HOST=postgres
DB_PORT=5432
DB_NAME=nguonpos
DB_USER=nguonpos
DB_PASSWORD=change-me

# Shared JWT signing secret across auth-service (issuer) and
# catalog-service/sales-service (validators). Generate a real random value
# for production, e.g.: openssl rand -base64 48
JWT_SIGNING_SECRET=change-me-to-a-real-random-secret

# Media library object storage (MinIO) — catalog-service writes, nginx serves /media/
MINIO_ROOT_USER=nguonmedia
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars
